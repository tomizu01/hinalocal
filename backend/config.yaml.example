# このファイルは backend/config.yaml の雛形です。
# このファイルをコピーして `config.yaml` を作成し、環境に合わせて書き換えて使用してください。
# 実体の config.yaml は .gitignore で除外されています。
# 外部APIは使わず、LLM は Ollama、TTS は AivisSpeech Engine をローカルネットワーク上で使う。

# ローカルLLM設定（Ollama）
llm:
  # Ollama サーバのベースURL。別PCで動かす場合は IP でも mDNS 名でもよい
  # 例: "http://192.168.1.20:11434" / "http://ollama-pc.local:11434"
  # ※別PCから接続するには Ollama 側で OLLAMA_HOST=0.0.0.0 を設定しておく
  base_url: "http://ollama-pc.local:11434"
  # メインの実況生成に使うモデル（画面キャプチャを送るので vision 対応が必須）
  model: "gemma4:26b"
  # 要約・感情判定・長期記憶抽出に使う軽量モデル（空ならメインと同じモデルを使う）
  sub_model: ""
  # 1回の生成を待つ上限（秒）。ローカル生成は遅いので長めに取る
  timeout_seconds: 180
  # 生成後もモデルをVRAM/メモリに保持する時間（Ollama の keep_alive）
  keep_alive: "30m"
  # thinking（推論トレース）の制御。gemma4 系のような thinking 対応モデルは
  # false にしないと出力が message.thinking 側に流れ、発話本文が空になる。
  # 空にすると think 自体を送らない（thinking 非対応モデルでエラーになる場合用）。
  think: false
  # Ollama に渡す生成オプション
  options:
    temperature: 1.0
    # コンテキスト長。会話履歴＋画像を入れるので余裕を持たせる
    num_ctx: 8192
    # 1回の発話の最大トークン数
    num_predict: 256

# ローカルTTS設定（AivisSpeech Engine）
tts:
  # AivisSpeech Engine のベースURL（既定ポートは 10101）
  # 別PCで動かす場合は Engine を --host 0.0.0.0 で起動しておく
  base_url: "http://aivis-pc.local:10101"
  # 合成待ちの上限（秒）
  timeout_seconds: 60
  # キャラの setting.yaml に style_id が無いときに使うスタイルID
  # 利用可能なIDは起動後に GET /api/tts/speakers で確認できる
  default_style_id: 888753760
  # AudioQuery の既定パラメータ（キャラ別に setting.yaml の tts: で上書き可）
  query:
    speedScale: 1.0
    pitchScale: 0.0
    intonationScale: 1.0
    volumeScale: 1.0
    tempoDynamicsScale: 1.0

# ローカルSTT設定（faster-whisper）
# 音声認識は **このマシン（Python を動かすマシン）の GPU** 上で動かす。
# Ollama / AivisSpeech と違い、LAN 上の別マシンには置けない（HTTP 越しではなく
# バックエンドのプロセス内で直接モデルを動かすため）。
# モデルはセットアップ時に `python backend\download_stt_model.py` でローカルへ取得し、
# 実行時は model_dir だけを読む＝外部ネットワークへ一切接続しない。
stt:
  # false にすると音声入力を無効化する（テキスト入力のみになる）
  enabled: true
  # モデル名。`python backend\download_stt_model.py --list` で一覧を確認できる。
  #   large-v3-turbo … 既定。精度と速度のバランスが良い（VRAM 約1.4GB / int8_float16）
  #   medium         … もう少し軽くしたいとき（VRAM 約1.0GB）
  #   small          … VRAM に余裕が無いとき（VRAM 約0.6GB、日本語の精度は落ちる）
  model: "large-v3-turbo"
  # 事前ダウンロードしたモデルの置き場所。ここが設定されている間は
  # local_files_only=True で読むためインターネット接続が不要。
  # 空にすると Hugging Face から取得を試みる（＝初回のみ要インターネット）。
  model_dir: "C:/hinalocal/backend/models/large-v3-turbo"
  # cuda（GPU）/ cpu。cuda で失敗したときの挙動は fallback_to_cpu で決める
  device: "cuda"
  # GPU が複数あるときの番号
  device_index: 0
  # 量子化方式。int8_float16 は float16 の半分程度の VRAM で精度低下がほぼ無い
  compute_type: "int8_float16"
  # GPU ロードに失敗したとき CPU で動かすか（CPU だと1発話に数秒〜十数秒かかる）
  fallback_to_cpu: true
  # 認識する言語。"ja" 固定にすると言語判定を省けて速くなり、誤判定も無くなる
  language: "ja"
  # ビームサーチの幅。大きいほど精度が上がるが遅くなる
  beam_size: 5
  # 無音区間を除去してから認識する（幻聴の抑制と処理時間の削減）
  vad_filter: true
  # 認識のヒント。固有名詞（キャラ名・ゲーム用語）を並べると精度が上がる
  initial_prompt: "ひな、りんか、まひろ、こはる。ゲーム実況の雑談。"
  # これを超えて「無音らしい」と判定されたセグメントは捨てる
  no_speech_threshold: 0.6
  # 平均対数尤度がこれを下回る認識結果は信頼しない
  log_prob_threshold: -1.0
  # 受け付ける音声データの最大バイト数
  max_upload_bytes: 10000000
  # 既定の幻聴フィルタ（「ご視聴ありがとうございました」等）に追加したい文字列
  hallucination_blocklist: []

# キャプチャ設定
capture:
  # 対象ゲームウィンドウのタイトル（部分一致）。
  # 起動時オプション --window で上書き可能。
  window_title: "Minecraft"
  # 加工後画像の保存フォルダ
  processing_dir: "C:/hinalocal/captures/processing"

# 画像加工設定（キャプチャしたウィンドウ画像に対する追加クリップ）
image:
  # クリップ座標（ウィンドウ左上を原点とする 左上 x1, y1 / 右下 x2, y2）。
  # すべて0なら クリップなし（ウィンドウ全体を使用）。
  clip:
    x1: 0
    y1: 0
    x2: 0
    y2: 0
  # リサイズ後の横幅（px）。縦は成り行き。0なら リサイズなし。
  # 小さいほど画像の入力トークンが減り、生成が速くなる（画面の細部は読み取りにくくなる）。
  resize_width: 512

# 会話履歴
history:
  # LLM呼び出し時に取得する直近の件数
  recent_count: 30

# メインループ
loop:
  # キャプチャ実行の間隔（秒）
  interval_seconds: 10

# DB
database:
  path: "C:/hinalocal/backend/data.db"

# プロンプトファイル
# キャラ別プロンプト（character.md / cheer.md）は
# backend/characters/<character.current_id>/prompts/ 配下から自動で解決される。
# cheer.md の代わりに使うファイルは起動オプション --cheer で上書き可能。
prompts:
  # 中期記憶生成用テンプレート。{target_chars} {history_text} {game_name} を埋め込む
  summary_path: "C:/hinalocal/backend/prompts/summary.md"

# ゲーム
game:
  # 現在プレイ中のゲームの表示名（プロンプトに埋め込まれる）
  name: "Minecraft"

# キャラクター
character:
  # 現在のキャラクターID（A-Za-z、1-16文字）
  # 会話履歴・各種記憶はこのIDに紐づく。
  # 起動オプション --char_id で上書き可能。
  # キャラ関連ファイルは下記から自動解決される：
  #   backend/characters/<id>/setting.yaml
  #   backend/characters/<id>/prompts/character.md
  #   backend/characters/<id>/prompts/cheer.md
  #   frontend/images/<id>/stand.png, talk.png
  current_id: "hina"

# 記憶レイヤー
memory:
  mid_term:
    # 要約対象の直近会話件数
    window_size: 30
    # 要約の目標文字数
    target_chars: 100
    # 前回処理時から何件の会話が追加されたらバッチを走らせるか
    batch_threshold: 20
    # バッチループの待機間隔（秒）
    interval_seconds: 10
