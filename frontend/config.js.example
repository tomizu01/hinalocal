// このファイルは frontend/config.js の雛形です。
// このファイルをコピーして `config.js` を作成し、環境に合わせて書き換えて使用してください。
// 実体の config.js は .gitignore で除外されています。

// フロント側設定。TTS は バックエンドの /api/tts 経由で
// ローカルネットワーク上の AivisSpeech Engine に中継されるため、
// 接続先やスタイルIDの設定は backend/config.yaml 側で行う。
window.HINALOCAL_CONFIG = {
  tts: {
    // ハルシネーション対策：再生開始から固定 ms で強制停止
    audioMaxMs: 25000,
  },
  // 音声入力（ローカルSTT = バックエンドの /api/stt → faster-whisper）
  // 録音の切り上げはブラウザ側の簡易VAD（音量ベース）で判定する
  stt: {
    // 録音開始後、これだけ無音が続いたら「喋らなかった」として取り消す（ms）
    speechStartTimeoutMs: 6000,
    // 発話が始まったあと、これだけ無音が続いたら録音を終了する（ms）
    silenceEndMs: 900,
    // 1回の録音の上限（ms）
    maxRecordMs: 20000,
    // これより短い発話は物音の誤検知とみなして捨てる（ms）
    minSpeechMs: 300,
    // 暗騒音の何倍を超えたら「喋っている」とみなすか
    vadNoiseMultiplier: 3.0,
    // 暗騒音がとても小さい環境向けの下限しきい値（RMS 0.0-1.0）
    vadMinRms: 0.012,
  },
  // タイプライター表示速度（文字/秒）
  typewriterCharsPerSecond: 7,
  // メッセージポーリング間隔（ミリ秒）
  pollIntervalMs: 5000,
  // 自動マイクON時、再生終了後にマイクを開くまでのガード時間（ミリ秒）
  autoMicGuardMs: 300,
};
